+// CPU worker threads for graph compute. Upstream uses 4; NEMO_SPEECH_CPU_THREADS overrides it
+// (susurroLive patch: long offline diarization is CPU-bound on machines without a GPU).
+static int
+cpu_compute_threads() {
+    static const int n = [] {
+        const char* env = std::getenv("NEMO_SPEECH_CPU_THREADS");
+        const int v = env ? std::atoi(env) : 0;
+        return v > 0 && v <= 256 ? v : 4;
+    }();
+    return n;
+}
